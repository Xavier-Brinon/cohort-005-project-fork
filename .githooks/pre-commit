#!/bin/sh
# Every check but the client bundle, in parallel, within a 3-second budget.
# Lint, format and the token budget look at the staged files only; typecheck,
# boundaries and tests cover the whole project. The full `node --run check`,
# client bundle included, runs on pre-push.
# Installed by `npm run prepare` (git config core.hooksPath .githooks).
#
# Format failure: run `npm run format`, then `git add` the result.
set -e
node scripts/check.ts --staged
