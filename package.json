{
  "name": "cadence-course-platform",
  "private": true,
  "description": "An awesome course platform",
  "type": "module",
  "scripts": {
    "cherry-pick": "ai-hero-cli cherry-pick --branch=live-run-through --upstream=https://github.com/ai-hero-dev/cohort-005-project.git",
    "reset": "ai-hero-cli reset --branch=live-run-through --upstream=https://github.com/ai-hero-dev/cohort-005-project.git",
    "create-pr": "ai-hero-cli create-pr --branch=live-run-through --upstream=https://github.com/ai-hero-dev/cohort-005-project.git",
    "pull": "ai-hero-cli pull --upstream=https://github.com/ai-hero-dev/cohort-005-project.git",
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "request-logger": "node --import ./scripts/resolve-app-imports.ts request-logger/proxy.ts",
    "typecheck": "react-router typegen && node node_modules/typescript7/bin/tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "node scripts/mutate-diff.ts --force",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node --import ./scripts/resolve-app-imports.ts scripts/seed.ts",
    "seed-wayfinder-issues": "bash scripts/seed-wayfinder-issues.sh",
    "db:migrate": "drizzle-kit migrate",
    "knock:validate": "node --env-file-if-exists=.env node_modules/@knocklabs/cli/bin/run.js workflow validate --all --environment development",
    "knock:push": "node --env-file-if-exists=.env node_modules/@knocklabs/cli/bin/run.js workflow push --all --environment development --commit",
    "knock:check": "node --env-file-if-exists=.env scripts/knock-workflows.ts check",
    "loc": "git ls-files | grep -vE '(lock|.db|_snapshot.json)' | xargs wc -l",
    "lint:boundaries": "depcruise app --ignore-known",
    "lint:boundaries:baseline": "depcruise-baseline app",
    "lint": "oxlint",
    "lint:boolean-names": "node scripts/check-boolean-names.ts",
    "lint:prune": "oxlint --prune-suppressions && node scripts/check-boolean-names.ts --prune",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:client-bundle": "react-router build && node scripts/check-client-bundle.ts",
    "check": "node scripts/check.ts --full",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@knocklabs/node": "^1.41.1",
    "@knocklabs/react": "^0.15.1",
    "@monaco-editor/react": "^4.7.0",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.31",
    "lucide-react": "^0.563.0",
    "marked": "^17.0.1",
    "monaco-editor": "^0.56.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.0",
    "recharts": "2.15.4",
    "shiki": "^3.22.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.14.0",
    "@clack/prompts": "^1.7.0",
    "@knocklabs/agent-toolkit": "^0.5.8",
    "@knocklabs/cli": "^1.6.2",
    "@knocklabs/mgmt": "^0.46.1",
    "@react-router/dev": "8.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/youtube": "^0.1.2",
    "@typescript-eslint/typescript-estree": "8.73.0",
    "ai-hero-cli": "0.13.0",
    "dependency-cruiser": "^18.7.2",
    "drizzle-kit": "^0.31.4",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^80.0.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-config": "git+https://github.com/Xavier-Brinon/oxlint-config.git",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "^3.8.1",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
