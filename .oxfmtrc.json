// Migrated from .prettierrc and .prettierignore with `oxfmt --migrate=prettier`.
// oxfmt also reads .gitignore.
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "trailingComma": "es5",
  "semi": true,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    // Generated: migrations and their snapshots are written by drizzle-kit.
    "drizzle/",

    // Vendored agent skills and harness config, owned upstream.
    ".agents/",
    ".claude/",
    ".sandcastle/",
    ".grill/",
    "_internal/",

    // Lockfiles.
    "package-lock.json",
    "aube-lock.yaml",
    "skills-lock.json",

    // Baselines written by the lint tools.
    "oxlint-suppressions.json",
    ".dependency-cruiser-known-violations.json"
  ]
}
